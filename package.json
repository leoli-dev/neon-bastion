{
  "name": "neon-bastion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Neon Bastion - a 4v4 web arena team shooter FPS, no backend, browser only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/three": "0.185.0",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "2.1.9"
  }
}
